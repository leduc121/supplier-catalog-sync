# -----------------------------------------------------------------------------
# Neon PostgreSQL / Vercel Serverless Configuration
# -----------------------------------------------------------------------------

# Neon pooled connection string (port 6543 / contains -pooler).
# Configure this in Vercel Project Settings -> Environment Variables.
# Required for Vercel Function runtime execution.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string (port 5432 / direct connection without pooler).
# Used for running schema migrations via `go run ./cmd/migrate`.
# Safe for advisory transaction locks and DDL.
DATABASE_DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Canonical production origin (e.g. https://your-project.vercel.app or custom domain).
# If omitted on Vercel, auto-derives from VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
PUBLIC_ORIGIN=https://your-project.vercel.app

# -----------------------------------------------------------------------------
# Local Development Configuration
# -----------------------------------------------------------------------------
# Local PostgreSQL database (see VERCEL_DEPLOYMENT.md for docker run command)
# DATABASE_URL=postgres://postgres:localdev@127.0.0.1:5432/supplier_catalog?sslmode=disable
# DATABASE_DIRECT_URL=postgres://postgres:localdev@127.0.0.1:5432/supplier_catalog?sslmode=disable
# TEST_DATABASE_URL=postgres://postgres:localdev@127.0.0.1:5432/supplier_catalog_test?sslmode=disable
# PORT=8080
# DATA_DIR=data

# -----------------------------------------------------------------------------
# Legacy Docker Compose & Ubuntu Deployment Configuration
# -----------------------------------------------------------------------------
# DOMAIN=catalog.example.com
# APP_IMAGE=supplier-catalog-sync:latest
